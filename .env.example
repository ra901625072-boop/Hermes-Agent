# =============================================================================
# Hermes Agent — Environment Variables
# ⚠️  DO NOT put real values here. This file is committed to the repo.
#     Set actual secrets in Railway's Variables panel (encrypted at rest).
# =============================================================================

# --- LLM Provider (Google Gemini) ---
GOOGLE_API_KEY=your-google-api-key-here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=your-numeric-telegram-user-id
TELEGRAM_HOME_CHANNEL=your-telegram-chat-id-for-cron-results

# --- GitHub (fine-grained PAT) ---
GITHUB_TOKEN=ghp_your-fine-grained-pat-here

# --- Dashboard (required when publicly exposed) ---
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=choose-a-strong-password

# --- Container / Railway ---
HERMES_HOME=/opt/data
HERMES_ALLOW_ROOT_GATEWAY=1
TZ=Asia/Kolkata
PORT=9119
